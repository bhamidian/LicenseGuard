{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    "ConnectionString": "",
    "Provider": "mysql",
    "ServerVersion": "8.0.29"
  },
  "JwtToken": {
    "Issuer": "LicenseGuard",
    "Audience": "LicenseGuard.Client",
    "PrivateKeyPem": "",
    "PublicKeyPem": "",
    "AccessTokenLifetimeMinutes": 15
  },
  "LicenseSigning": {
    "PrivateKeyPem": "",
    "PublicKeyPem": ""
  },
  "Identity": {
    "RequireUniqueEmail": true,
    "LockoutEnabledForNewUsers": true,
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 15
  },
  "RateLimits": {
    "LicenseClientPolicyName": "license-client",
    "AuthRequestCodePolicyName": "auth-request-code",
    "AuthVerifyCodePolicyName": "auth-verify-code",
    "LicenseClientPermitLimit": 30,
    "AuthRequestCodePermitLimit": 3,
    "AuthVerifyCodePermitLimit": 5,
    "WindowMinutes": 1,
    "QueueLimit": 0,
    "RejectionStatusCode": 429,
    "AutoReplenishment": true,
    "UnknownClientPartitionKey": "unknown-client"
  },
  "AllowedHosts": "*"
}

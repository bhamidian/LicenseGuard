    CUSTOMER {
        guid Id PK
        guid AppUserId
    }
    PRODUCT {
        guid Id PK
        string Code UK
        string Name
    }
    PLAN {
        guid Id PK
        guid ProductId FK
        string Name
        decimal Price
    }
    FEATURE {
        guid Id PK
        string Code UK
        string Name
    }
    SUBSCRIPTION {
        guid Id PK
        guid CustomerId FK
        guid ProductId FK
        guid PlanId FK
        guid CurrentLicenseId FK
        datetime StartDate
        datetime EndDate
        int Status
    }
    LICENSE {
        guid Id PK
        guid SubscriptionId FK
        string Key UK
        string Signature
        int LicenseStatus
        datetime StartDate
        datetime ExpirationDate
    }
    SUBSCRIPTION_RENEWAL {
        guid Id PK
        guid SubscriptionId FK
        datetime RenewedAt
        datetime PreviousExpirationDate
        datetime NewExpirationDate
        decimal Amount
    }
    LICENSE_ACTIVATION {
        guid Id PK
        guid LicenseId FK
        string MachineId
        string InstanceId
        datetime ActivatedAt
        datetime LastValidatedTime
        datetime DeactivatedAt
        int Status
    }
    LICENSE_STATUS_HISTORY {
        guid Id PK
        guid LicenseId FK
        int Status
        datetime ChangedAt
        string Reason
        guid ChangedByUserId
    }
    PRODUCT_FEATURE {
        guid Id PK
        guid ProductId FK
        guid FeatureId FK
    }
    PLAN_FEATURE {
        guid Id PK
        guid PlanId FK
        guid FeatureId FK
    }
    LICENSE_FEATURE {
        guid Id PK
        guid LicenseId FK
        guid FeatureId FK
        boolean IsEnabled
    }
    LICENSE_LIMIT {
        guid Id PK
        guid LicenseId FK
        string Code
        decimal Value
        string Unit
    }
    LICENSE_AUDIT_LOG {
        guid Id PK
        guid LicenseId FK
        datetime CreatedAt
        string Action
        string EntityType
        string EntityId
        boolean IsSuccess
    }
